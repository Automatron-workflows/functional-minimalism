      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; script-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'\">\n\n\n<title>Review payment - PayFlow</title>\n<style>\n:root {\n  --bg: #0a0c10;\n  --surface: #12161d;\n  --surface-2: #1a202a;\n  --text: #eef2f7;\n  --muted: #a7b0bf;\n  --line: rgba(255, 255, 255, 0.1);\n  --accent: #3b5bdb;\n  --accent-hover: #2f4ac4;\n  --focus: #ffffff;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  font-size: 16px;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background: var(--bg);\n  color: var(--text);\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  line-height: 1.5;\n}\n\na {\n  color: var(--muted);\n  text-decoration: none;\n}\n\na:hover {\n  color: var(--text);\n  text-decoration: underline;\n}\n\nbutton {\n  font: inherit;\n}\n\n.shell-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  padding: 20px 40px;\n  border-bottom: 1px solid var(--line);\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n\n.brand-mark {\n  display: grid;\n  place-items: center;\n  width: 32px;\n  height: 32px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  font-size: 0.95rem;\n}\n\n.user {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  color: var(--muted);\n}\n\n.avatar {\n  display: grid;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  color: var(--text);\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n\n.page {\n  width: min(1240px, calc(100% - 80px));\n  margin: 0 auto;\n  padding: 32px 0 48px;\n}\n\n.back-link {\n  display: inline-block;\n  margin-bottom: 24px;\n  font-size: 0.95rem;\n}\n\nh1 {\n  margin: 0 0 32px;\n  font-size: clamp(2rem, 4vw, 3rem);\n  line-height: 1.05;\n  letter-spacing: -0.03em;\n}\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);\n  gap: 40px;\n  align-items: start;\n}\n\n.document {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 36px;\n}\n\n.doc-kicker {\n  margin: 0 0 4px;\n  color: var(--muted);\n  font-size: 0.85rem;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.doc-title {\n  margin: 0 0 8px;\n  font-size: 1.5rem;\n  line-height: 1.15;\n}\n\n.doc-meta {\n  margin: 0 0 32px;\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n.doc-section + .doc-section {\n  margin-top: 32px;\n}\n\n.doc-section h2 {\n  margin: 0 0 12px;\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: var(--muted);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.supplier-name {\n  margin: 0 0 8px;\n  font-size: 1.15rem;\n  font-weight: 600;\n}\n\n.supplier-details {\n  margin: 0;\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n.items {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.items th,\n.items td {\n  padding: 10px 0;\n  text-align: left;\n  font-size: 0.95rem;\n}\n\n.items th {\n  color: var(--muted);\n  font-weight: 500;\n  border-bottom: 1px solid var(--line);\n}\n\n.items td:last-child,\n.items th:last-child {\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n.items tbody tr + tr td {\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n}\n\n.totals {\n  margin-top: 16px;\n  padding-top: 16px;\n  border-top: 1px solid var(--line);\n}\n\n.total-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 6px 0;\n  font-size: 0.95rem;\n}\n\n.total-row span:last-child {\n  font-variant-numeric: tabular-nums;\n}\n\n.total-row.strong {\n  margin-top: 8px;\n  font-size: 1.05rem;\n  font-weight: 700;\n}\n\n.fact-list {\n  display: grid;\n  gap: 20px;\n  margin: 0;\n}\n\n.fact {\n  display: grid;\n  gap: 4px;\n}\n\n.fact dt {\n  color: var(--muted);\n  font-size: 0.8rem;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.fact dd {\n  margin: 0;\n  font-size: 1.05rem;\n  font-weight: 500;\n}\n\n.fact.amount dd {\n  font-size: clamp(2.5rem, 5vw, 3.5rem);\n  line-height: 1;\n  font-weight: 700;\n  letter-spacing: -0.04em;\n  font-variant-numeric: tabular-nums;\n}\n\n.supporting {\n  display: grid;\n  gap: 12px;\n  margin: 28px 0;\n  padding-top: 24px;\n  border-top: 1px solid var(--line);\n}\n\n.supporting div {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  font-size: 0.9rem;\n}\n\n.supporting dt {\n  color: var(--muted);\n}\n\n.supporting dd {\n  margin: 0;\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n.consequence {\n  margin: 0 0 24px;\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n\n.actions {\n  display: grid;\n  gap: 12px;\n}\n\n.primary-action {\n  width: 100%;\n  min-height: 48px;\n  border: 0;\n  border-radius: 6px;\n  background: var(--accent);\n  color: #ffffff;\n  font-size: 1rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.primary-action:hover {\n  background: var(--accent-hover);\n}\n\n.secondary-action {\n  width: 100%;\n  min-height: 44px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: transparent;\n  color: var(--muted);\n  font-size: 0.95rem;\n  cursor: pointer;\n}\n\n.secondary-action:hover {\n  color: var(--text);\n  border-color: rgba(255, 255, 255, 0.22);\n}\n\nbutton:focus-visible,\na:focus-visible {\n  outline: 2px solid var(--focus);\n  outline-offset: 3px;\n}\n\n@media (max-width: 900px) {\n  .page {\n    width: min(100% - 32px, 1240px);\n    padding-top: 24px;\n  }\n\n  .shell-header {\n    padding: 16px;\n  }\n\n  .workspace {\n    grid-template-columns: 1fr;\n    gap: 28px;\n  }\n\n  .document {\n    padding: 24px;\n  }\n\n  h1 {\n    font-size: 2rem;\n    margin-bottom: 24px;\n  }\n}\n\n@media (max-width: 390px) {\n  .fact.amount dd {\n    font-size: 2.25rem;\n  }\n\n  .items th,\n  .items td {\n    font-size: 0.9rem;\n  }\n}\n</style>\n</head>\n<body>\n<header class=\"shell-header\">\n  <div class=\"brand\">\n    <div class=\"brand-mark\">P</div>\n    <span>PayFlow</span>\n  </div>\n  <div class=\"user\">\n    <span>Maya Chen</span>\n    <div class=\"avatar\">MC</div>\n  </div>\n</header>\n\n<main class=\"page\">\n  <a class=\"back-link\" href=\"#\">&larr; Back to invoices</a>\n  <h1>Review payment</h1>\n\n  <div class=\"workspace\">\n    <section class=\"document\" aria-labelledby=\"invoice-title\">\n      <p class=\"doc-kicker\">Invoice</p>\n      <h2 class=\"doc-title\" id=\"invoice-title\">INV-0042</h2>\n      <p class=\"doc-meta\">Issued 6 Nov 2026 · Due 20 Nov 2026</p>\n\n      <div class=\"doc-section\">\n        <h2>Supplier</h2>\n        <p class=\"supplier-name\">North Studio Ltd</p>\n        <p class=\"supplier-details\">\n          14 Riverbank Way<br>\n          Dublin 2, D02 X4Y7, Ireland<br>\n          VAT: IE1234567T<br>\n          billing@northstudio.example<br>\n          Account manager: Aoife Brennan\n        </p>\n      </div>\n\n      <div class=\"doc-section\">\n        <h2>Line items</h2>\n        <table class=\"items\">\n          <thead>\n            <tr>\n              <th scope=\"col\">Description</th>\n              <th scope=\"col\">Amount</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>Brand identity refresh</td>\n              <td>€620.00</td>\n            </tr>\n            <tr>\n              <td>Web design (5 pages)</td>\n              <td>€260.00</td>\n            </tr>\n            <tr>\n              <td>Hosting setup</td>\n              <td>€120.00</td>\n            </tr>\n          </tbody>\n        </table>\n        <div class=\"totals\">\n          <div class=\"total-row\">\n            <span>Subtotal</span>\n            <span>€1,000.00</span>\n          </div>\n          <div class=\"total-row\">\n            <span>VAT (21%)</span>\n            <span>€210.00</span>\n          </div>\n          <div class=\"total-row strong\">\n            <span>Total due</span>\n            <span>€1,210.00</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"doc-section\">\n        <h2>Invoice details</h2>\n        <dl class=\"fact-list\">\n          <div class=\"fact\">\n            <dt>Invoice number</dt>\n            <dd>INV-0042</dd>\n          </div>\n          <div class=\"fact\">\n            <dt>Issued</dt>\n            <dd>6 Nov 2026</dd>\n          </div>\n          <div class=\"fact\">\n            <dt>Due date</dt>\n            <dd>20 Nov 2026</dd>\n          </div>\n          <div class=\"fact\">\n            <dt>Reference</dt>\n            <dd>PO-2026-018</dd>\n          </div>\n          <div class=\"fact\">\n            <dt>Currency</dt>\n            <dd>EUR (€)</dd>\n          </div>\n        </dl>\n      </div>\n    </section>\n\n    <aside class=\"summary\" aria-labelledby=\"summary-title\">\n      <h2 id=\"summary-title\">Payment summary</h2>\n\n      <dl class=\"fact-list\">\n        <div class=\"fact\">\n          <dt>Supplier</dt>\n          <dd>North Studio Ltd</dd>\n        </div>\n        <div class=\"fact amount\">\n          <dt>Amount</dt>\n          <dd>€1,210.00</dd>\n        </div>\n        <div class=\"fact\">\n          <dt>Due date</dt>\n          <dd>20 Nov 2026</dd>\n        </div>\n        <div class=\"fact\">\n          <dt>Destination</dt>\n          <dd>AIB Business Current Account<br>ending 4421</dd>\n        </div>\n      </dl>\n\n      <dl class=\"supporting\">\n        <div>\n          <dt>Payment method</dt>\n          <dd>Bank transfer (SEPA)</dd>\n        </div>\n        <div>\n          <dt>Scheduled date</dt>\n          <dd>20 Nov 2026</dd>\n        </div>\n        <div>\n          <dt>Available balance</dt>\n          <dd>€8,430.55</dd>\n        </div>\n      </dl>\n\n      <p class=\"consequence\">\n        No payment has been initiated. This is a review screen only. Approving will schedule the payment for the due date; funds are not moved until release. Fictional data shown for demonstration.\n      </p>\n\n      <div class=\"actions\">\n        <button class=\"primary-action\" type=\"button\" data-primary>Review payment</button>\n        <button class=\"secondary-action\" type=\"button\">Cancel review</button>\n      </div>\n    </aside>\n  </div>\n</main>\n</body>\n</html>",
