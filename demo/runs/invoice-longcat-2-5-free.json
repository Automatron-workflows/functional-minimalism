      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; script-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'\">\n\n\n<title>Invoice 0042 — Review payment · Business Banking</title>\n<style>\n  :root{\n    --canvas:#F4F0E8;\n    --surface:#FFFFFF;\n    --ink:#171614;\n    --muted:#6D6860;\n    --line:#E5DED2;\n    --accent:#1F5B46;\n    --onaccent:#FFFFFF;\n    --serif:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,Georgia,serif;\n    --sans:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html{-webkit-text-size-adjust:100%}\n  body{\n    background:var(--canvas);\n    color:var(--ink);\n    font-family:var(--sans);\n    font-size:14px;\n    line-height:1.5;\n  }\n  .page{\n    max-width:1120px;\n    margin:0 auto;\n    padding:32px 48px 0;\n  }\n\n  /* Header */\n  .top{\n    display:flex;\n    justify-content:space-between;\n    align-items:baseline;\n    padding-bottom:16px;\n    border-bottom:1px solid var(--line);\n    margin-bottom:32px;\n  }\n  .brand-name{\n    display:block;\n    font-family:var(--serif);\n    font-size:16px;\n    line-height:1.3;\n  }\n  .brand-sub{\n    display:block;\n    margin-top:2px;\n    font-size:12px;\n    color:var(--muted);\n  }\n\n  /* Layout */\n  .layout{\n    display:flex;\n    gap:64px;\n    align-items:flex-start;\n  }\n\n  /* Document */\n  .doc{\n    flex:1 1 auto;\n    min-width:0;\n    background:var(--surface);\n    border:1px solid var(--line);\n    border-radius:14px;\n    padding:32px;\n    box-shadow:0 1px 2px rgba(23,22,20,.05),0 18px 44px -16px rgba(23,22,20,.14);\n  }\n  .doc-head{\n    display:flex;\n    justify-content:space-between;\n    gap:24px;\n    padding-bottom:24px;\n    border-bottom:1px solid var(--line);\n  }\n  .eyebrow{\n    font-size:11px;\n    text-transform:uppercase;\n    letter-spacing:.08em;\n    color:var(--muted);\n  }\n  h1{\n    margin-top:8px;\n    font-family:var(--serif);\n    font-size:30px;\n    font-weight:600;\n    line-height:1.2;\n  }\n  .issued{\n    margin-top:4px;\n    font-size:12px;\n    color:var(--muted);\n  }\n  .due{text-align:right}\n  .due .value{\n    margin-top:4px;\n    font-size:16px;\n    font-weight:600;\n  }\n\n  .parties{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:32px;\n    padding:24px 0;\n    border-bottom:1px solid var(--line);\n  }\n  .party .name{\n    margin-top:8px;\n    font-weight:600;\n  }\n  .party p{\n    margin-top:4px;\n    font-size:12px;\n    line-height:1.5;\n    color:var(--muted);\n  }\n\n  .items{\n    width:100%;\n    border-collapse:collapse;\n    margin:24px 0 8px;\n  }\n  .items th{\n    padding:0 0 8px;\n    font-size:11px;\n    font-weight:500;\n    text-transform:uppercase;\n    letter-spacing:.08em;\n    color:var(--muted);\n    text-align:left;\n  }\n  .items th.num,\n  .items td.num{text-align:right}\n  .items td{\n    padding:12px 0;\n    border-bottom:1px solid var(--line);\n    font-variant-numeric:tabular-nums;\n  }\n  .items tbody tr:last-child td{border-bottom:0}\n\n  .totals{\n    width:240px;\n    margin-left:auto;\n    padding-top:16px;\n    border-top:1px solid var(--line);\n  }\n  .row{\n    display:flex;\n    justify-content:space-between;\n    gap:16px;\n    padding:4px 0;\n  }\n  .row .k{font-size:12px;color:var(--muted)}\n  .row .v{font-size:14px;font-variant-numeric:tabular-nums}\n  .row.total{\n    margin-top:8px;\n    padding-top:12px;\n    border-top:1px solid var(--line);\n  }\n  .row.total .k{font-size:14px;font-weight:600;color:var(--ink)}\n  .row.total .v{font-size:16px;font-weight:600}\n\n  /* Summary rail */\n  .rail{\n    flex:0 0 360px;\n    width:360px;\n  }\n  .amount{\n    margin:8px 0 4px;\n    font-family:var(--serif);\n    font-size:clamp(56px,18vw,72px);\n    line-height:1.05;\n    letter-spacing:-.01em;\n    font-variant-numeric:tabular-nums;\n  }\n  .hero .sub{\n    font-size:12px;\n    color:var(--muted);\n  }\n  .facts{\n    margin-top:24px;\n    border-top:1px solid var(--line);\n  }\n  .fact{\n    display:flex;\n    justify-content:space-between;\n    gap:16px;\n    padding:12px 0;\n    border-bottom:1px solid var(--line);\n  }\n  .fact .k{\n    padding-top:2px;\n    font-size:11px;\n    text-transform:uppercase;\n    letter-spacing:.08em;\n    color:var(--muted);\n  }\n  .fact .v{\n    font-size:14px;\n    text-align:right;\n  }\n  .consequence{\n    margin-top:24px;\n    font-size:12px;\n    line-height:1.5;\n    color:var(--muted);\n  }\n  .primary{\n    margin-top:16px;\n    width:100%;\n    height:48px;\n    border:0;\n    border-radius:8px;\n    background:var(--accent);\n    color:var(--onaccent);\n    font-family:var(--sans);\n    font-size:14px;\n    font-weight:600;\n    cursor:pointer;\n  }\n  .primary:hover{background:#184a39}\n  .primary:focus-visible{\n    outline:2px solid var(--accent);\n    outline-offset:2px;\n  }\n  .secondary{\n    display:block;\n    margin:12px auto 0;\n    padding:4px;\n    background:none;\n    border:0;\n    color:var(--muted);\n    font-family:var(--sans);\n    font-size:14px;\n    cursor:pointer;\n    text-decoration:underline;\n    text-underline-offset:3px;\n  }\n  .secondary:hover{color:var(--ink)}\n  .secondary:focus-visible{\n    outline:2px solid var(--accent);\n    outline-offset:2px;\n    border-radius:4px;\n  }\n\n  .foot{\n    margin-top:48px;\n    padding:24px 0 32px;\n    border-top:1px solid var(--line);\n    text-align:center;\n    font-size:12px;\n    color:var(--muted);\n  }\n\n  @media (max-width:900px){\n    .layout{flex-direction:column;gap:32px}\n    .rail{width:100%;flex:1 1 auto;order:-1}\n  }\n  @media (max-width:640px){\n    .page{padding:24px 24px 0}\n    .doc{padding:24px}\n    .doc-head{flex-direction:column;gap:16px}\n    .due{text-align:left}\n    .parties{grid-template-columns:1fr;gap:24px}\n    .items{margin:16px 0 8px}\n    .items thead{display:none}\n    .items tbody tr{\n      display:block;\n      padding:12px 0;\n      border-bottom:1px solid var(--line);\n    }\n    .items tbody tr:last-child{border-bottom:0}\n    .items td{\n      display:flex;\n      justify-content:space-between;\n      gap:16px;\n      padding:2px 0;\n      border:0;\n    }\n    .items td::before{\n      content:attr(data-label);\n      font-size:11px;\n      text-transform:uppercase;\n      letter-spacing:.08em;\n      color:var(--muted);\n    }\n    .totals{width:100%}\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <header class=\"top\">\n    <div class=\"brand\">\n      <span class=\"brand-name\">Business Banking</span>\n      <span class=\"brand-sub\">Payments console</span>\n    </div>\n  </header>\n\n  <div class=\"layout\">\n\n    <section class=\"doc\" aria-label=\"Invoice document\">\n      <div class=\"doc-head\">\n        <div>\n          <div class=\"eyebrow\">Supplier document · EUR</div>\n          <h1>Invoice 0042</h1>\n          <div class=\"issued\">Issued 6 November 2026</div>\n        </div>\n        <div class=\"due\">\n          <div class=\"eyebrow\">Due date</div>\n          <div class=\"value\">20 November 2026</div>\n        </div>\n      </div>\n\n      <div class=\"parties\">\n        <div class=\"party\">\n          <div class=\"eyebrow\">Supplier</div>\n          <div class=\"name\">North Studio</div>\n          <p>14 Example Quay, Riverside Park, Sample City, SC1 2AB</p>\n          <p>VAT SAMPLE-GB-000042</p>\n          <p>accounts@northstudio.example</p>\n        </div>\n        <div class=\"party\">\n          <div class=\"eyebrow\">Billed to</div>\n          <div class=\"name\">Meridian Retail Group BV</div>\n          <p>Boezemweg 14, 3051 SC Rotterdam, Netherlands</p>\n          <p>VAT NL8641.22.905.B01</p>\n        </div>\n      </div>\n\n      <table class=\"items\">\n        <thead>\n          <tr>\n            <th scope=\"col\">Description</th>\n            <th scope=\"col\" class=\"num\">Qty</th>\n            <th scope=\"col\" class=\"num\">Unit price</th>\n            <th scope=\"col\" class=\"num\">Amount</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td data-label=\"Description\">Brand identity refresh, phase 2</td>\n            <td data-label=\"Qty\" class=\"num\">1</td>\n            <td data-label=\"Unit price\" class=\"num\">€700.00</td>\n            <td data-label=\"Amount\" class=\"num\">€700.00</td>\n          </tr>\n          <tr>\n            <td data-label=\"Description\">Print-ready asset package</td>\n            <td data-label=\"Qty\" class=\"num\">1</td>\n            <td data-label=\"Unit price\" class=\"num\">€300.00</td>\n            <td data-label=\"Amount\" class=\"num\">€300.00</td>\n          </tr>\n        </tbody>\n      </table>\n\n      <div class=\"totals\">\n        <div class=\"row\">\n          <span class=\"k\">Subtotal</span>\n          <span class=\"v\">€1,000.00</span>\n        </div>\n        <div class=\"row\">\n          <span class=\"k\">VAT</span>\n          <span class=\"v\">€210.00 (21%)</span>\n        </div>\n        <div class=\"row total\">\n          <span class=\"k\">Total due</span>\n          <span class=\"v\">€1,210.00</span>\n        </div>\n      </div>\n    </section>\n\n    <aside class=\"rail\" aria-label=\"Payment summary\">\n      <div class=\"hero\">\n        <div class=\"eyebrow\">Amount to leave account</div>\n        <div class=\"amount\">€1,210.00</div>\n        <div class=\"sub\">incl. VAT €210.00 (21%)</div>\n      </div>\n\n      <div class=\"facts\">\n        <div class=\"fact\">\n          <span class=\"k\">Supplier</span>\n          <span class=\"v\">North Studio</span>\n        </div>\n        <div class=\"fact\">\n          <span class=\"k\">From account</span>\n          <span class=\"v\">Business Current Account ending 4421</span>\n        </div>\n        <div class=\"fact\">\n          <span class=\"k\">Destination</span>\n          <span class=\"v\">North Studio business account</span>\n        </div>\n        <div class=\"fact\">\n          <span class=\"k\">Due date</span>\n          <span class=\"v\">20 November 2026</span>\n        </div>\n      </div>\n\n      <p class=\"consequence\">Review only. No payment is sent, scheduled or authorised from this screen.</p>\n\n      <button type=\"button\" class=\"primary\">Review payment</button>\n      <button type=\"button\" class=\"secondary\">Cancel review</button>\n    </aside>\n\n  </div>\n\n  <footer class=\"foot\">Demonstration screen · All names, accounts and figures are fictional.</footer>\n\n</div>\n</body>\n</html>",
