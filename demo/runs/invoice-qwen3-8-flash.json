lid var(--line);\n      border-radius: 16px;\n      padding: 18px;\n      box-shadow: var(--shadow);\n      min-width: 0;\n    }\n\n    .mini-title {\n      font-size: 12px;\n      color: var(--muted);\n      text-transform: uppercase;\n      letter-spacing: 0.06em;\n      margin-top: 12px;\n      font-weight: 700;\n    }\n\n    .mini-value {\n      font-size: 18px;\n      font-weight: 780;\n      margin-top: 6px;\n      letter-spacing: -0.02em;\n    }\n\n    .mini-sub {\n      font-size: 13px;\n      color: var(--muted);\n      margin-top: 4px;\n    }\n\n    .icon {\n      width: 44px;\n      height: 44px;\n      border-radius: 14px;\n      position: relative;\n      flex: 0 0 auto;\n    }\n\n    .icon-supplier {\n      background: #eaf1ff;\n    }\n\n    .icon-supplier::before {\n      content: \"\";\n      position: absolute;\n      width: 14px;\n      height: 14px;\n      border-radius: 50%;\n      background: var(--accent);\n      top: 10px;\n      left: 15px;\n    }\n\n    .icon-supplier::after {\n      content: \"\";\n      position: absolute;\n      width: 22px;\n      height: 12px;\n      border-radius: 12px 12px 0 0;\n      background: var(--accent);\n      bottom: 10px;\n      left: 11px;\n    }\n\n    .icon-amount {\n      background: var(--safe-bg);\n    }\n\n    .icon-amount::before {\n      content: \"\";\n      position: absolute;\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      border: 3px solid var(--safe);\n      left: 10px;\n      top: 10px;\n    }\n\n    .icon-amount::after {\n      content: \"\";\n      position: absolute;\n      width: 10px;\n      height: 10px;\n      border-radius: 50%;\n      background: var(--safe);\n      left: 17px;\n      top: 17px;\n    }\n\n    .icon-date {\n      background: var(--warn-bg);\n    }\n\n    .icon-date::before {\n      content: \"\";\n      position: absolute;\n      width: 26px;\n      height: 22px;\n      border: 3px solid var(--warn);\n      border-radius: 6px;\n      left: 9p