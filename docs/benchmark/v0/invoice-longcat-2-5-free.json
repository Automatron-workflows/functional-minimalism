play:flex;gap:4px;margin-left:8px}\n  .mainnav a{\n    text-decoration:none;color:var(--muted);\n    font-size:.86rem;padding:8px 12px;border-radius:8px;\n  }\n  .mainnav a:hover{color:var(--ink);background:#152232}\n  .biz{margin-left:auto;display:flex;align-items:center;gap:10px}\n  .biz-name{font-size:.86rem;color:var(--muted)}\n  .biz-badge{\n    width:30px;height:30px;border-radius:50%;\n    background:#1b2c40;border:1px solid var(--line);\n    color:var(--ink);font-size:.72rem;font-weight:700;\n    display:flex;align-items:center;justify-content:center;\n    letter-spacing:.02em;\n  }\n\n  /* ---------- Main ---------- */\n  .wrap{\n    width:100%;max-width:1200px;margin:0 auto;\n    padding:22px 24px 40px;flex:1 0 auto;\n  }\n  .crumbs{\n    display:flex;align-items:center;gap:8px;\n    font-size:.8rem;color:var(--faint);margin-bottom:14px;\n  }\n  .crumbs a{text-decoration:none;color:var(--muted)}\n  .crumbs a:hover{color:var(--ink);text-decoration:underline}\n  .crumbs .sep{color:#3a4c63}\n  .crumbs .here{color:var(--muted)}\n\n  .intro{display:flex;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:20px}\n  h1{\n    font-size:clamp(1.5rem,2.4vw,1.9rem);\n    font-weight:750;letter-spacing:-.015em;margin:0;\n  }\n  .intro p{margin:0;color:var(--muted);font-size:.95rem;max-width:52ch}\n\n  .layout{\n    display:grid;\n    grid-template-columns:minmax(0,7fr) minmax(0,5fr);\n    gap:24px;align-items:start;\n  }\n\n  /* ---------- Document ---------- */\n  .doc{\n    background:var(--panel);\n    border:1px solid var(--line);\n    border-radius:var(--radius);\n    padding:26px 28px 24px;\n  }\n  .doc-head{\n    display:flex;justify-content:space-between;align-items:flex-start;\n    gap:18px;flex-wrap:wrap;\n    padding-bottom:18px;border-bottom:1px solid var(--line-soft);\n  }\n  .doc-supplier{display:flex;gap:14px;align-items:flex-start}\n  .avatar{\n    width:44px;height:44px;border-radius:11px;flex:0 0 auto;\n    background:#1b2c40;border:1px solid v