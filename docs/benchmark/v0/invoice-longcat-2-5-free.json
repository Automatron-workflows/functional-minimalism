ckground:var(--card);border:1px solid var(--line);border-radius:var(--radius);\n    box-shadow:0 1px 2px rgba(15,31,51,.04);\n  }\n  .card-head{\n    padding:18px 22px;border-bottom:1px solid var(--line);\n    display:flex;align-items:center;justify-content:space-between;gap:12px;\n  }\n  .card-head h2{font-size:15.5px;font-weight:700;}\n  .card-body{padding:22px;}\n  .badge{\n    display:inline-flex;align-items:center;gap:6px;\n    font-size:11.5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;\n    padding:5px 10px;border-radius:999px;\n  }\n  .badge.amber{background:var(--amber-bg);color:var(--amber);}\n  .badge.green{background:var(--green-bg);color:var(--green);}\n  .badge.blue{background:var(--blue-bg);color:var(--blue);}\n  .dot{width:7px;height:7px;border-radius:50%;background:currentColor;}\n\n  /* ---------- Invoice summary ---------- */\n  .supplier-row{display:flex;gap:14px;align-items:flex-start;margin-bottom:20px;}\n  .supplier-logo{\n    width:48px;height:48px;border-radius:12px;flex:none;\n    background:linear-gradient(135deg,#24456e,#3d6ea8);\n    color:#fff;display:flex;align-items:center;justify-content:center;\n    font-weight:800;font-size:15px;\n  }\n  .supplier-name{font-size:16px;font-weight:700;}\n  .supplier-meta{font-size:13px;color:var(--muted);margin-top:3px;line-height:1.5;}\n  .amount-block{\n    background:#f8fafc;border:1px solid var(--line);border-radius:12px;\n    padding:16px 18px;margin-bottom:18px;\n  }\n  .amount-label{font-size:11.5px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--muted);}\n  .amount-value{font-size:30px;font-weight:800;letter-spacing:-.5px;margin-top:4px;}\n  .due-chip{\n    display:inline-flex;align-items:center;gap:6px;margin-top:10px;\n    font-size:12.5px;font-weight:600;color:var(--ink-2);\n    background:#fff;border:1px solid var(--line);border-radius:8px;padding:6px 10px;\n  }\n  .kv{display:flex;justify-content:space-between;gap:16px;padding:9px 0;font-size:13