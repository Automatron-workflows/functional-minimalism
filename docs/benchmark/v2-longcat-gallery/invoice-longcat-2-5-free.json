      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; script-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'\">\n\n\n<title>Invoice 0042 · North Studio — Payment review</title>\n<style>\n:root{\n  --canvas:#F4F0E8;\n  --surface:#FFFFFF;\n  --ink:#171614;\n  --muted:#6D6860;\n  --line:#E5DED2;\n  --accent:#1F5B46;\n  --onaccent:#FFFFFF;\n  --display:\"Iowan Old Style\",Palatino,\"Palatino Linotype\",Georgia,serif;\n  --body:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{\n  margin:0;\n  background:var(--canvas);\n  color:var(--ink);\n  font-family:var(--body);\n  font-size:14px;\n  line-height:1.5;\n}\n.page{max-width:1120px;margin:0 auto;padding:48px}\n.label{margin:0;color:var(--muted);font-family:var(--body);font-size:11px;font-weight:500;letter-spacing:.08em;line-height:1.4;text-transform:uppercase}\n.muted{margin:0;color:var(--muted);font-size:13px;line-height:1.5}\n\n/* Brand and review line */\n.brand-line{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:0 0 24px;border-bottom:1px solid var(--line);margin-bottom:48px}\n.brand{margin:4px 0 0;font-family:var(--display);font-size:28px;line-height:1.1;letter-spacing:-.02em}\n.brand-line .label{white-space:nowrap}\n\n/* Layout */\n.layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:64px;align-items:start}\n\n/* Invoice document */\n.document{background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 50px rgba(27,26,23,.06);padding:48px;min-width:0}\n.doc-head{display:flex;justify-content:space-between;gap:32px;align-items:flex-start;padding-bottom:24px;border-bottom:1px solid var(--line)}\n.doc-head h1{margin:4px 0 0;font-family:var(--display);font-size:40px;font-weight:500;letter-spacing:-.03em;line-height:1.05}\n.doc-head .muted{margin-top:8px}\n.doc-meta{text-align:right}\n.doc-meta p{margin:4px 0 0;font-size:14px}\n.doc-meta .label{margin:0}\n\n/* Hero amount */\n.hero{margin:32px 0}\n.amount{margin:8px 0 4px;font-family:var(--display);font-size:72px;font-weight:500;line-height:.95;letter-spacing:-.045em;font-variant-numeric:tabular-nums}\n\n/* Parties */\n.parties{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin:24px 0}\n.party-name{margin:8px 0 4px;font-size:14px;font-weight:600}\n.parties .muted{margin:0 0 2px}\n\n/* Line items */\n.table-wrap{overflow-x:auto;margin:24px 0}\n.items{width:100%;border-collapse:collapse;margin:0;font-size:14px;font-variant-numeric:tabular-nums}\n.items th{padding:0 0 8px;border-bottom:1px solid var(--line);color:var(--muted);font-size:11px;font-weight:500;letter-spacing:.06em;text-align:left;text-transform:uppercase}\n.items td{padding:14px 0;border-bottom:1px solid var(--line)}\n.items th:first-child,.items td:first-child{width:52%}\n.items th:not(:first-child),.items td:not(:first-child){text-align:right}\n\n/* Totals */\n.totals{margin:24px 0 0;border-top:1px solid var(--line);font-variant-numeric:tabular-nums}\n.totals div{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--line)}\n.totals .total{font-weight:600}\n\n/* Summary rail */\n.summary{min-width:0}\n.facts{margin:24px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.facts div{display:grid;grid-template-columns:120px minmax(0,1fr);gap:16px;padding:12px 0;border-bottom:1px solid var(--line)}\n.facts div:last-child{border-bottom:0}\n.facts dt{color:var(--muted);font-size:12px}\n.facts dd{margin:0;text-align:right;font-size:14px;min-width:0}\n.consequence{margin:0 0 20px;color:var(--muted);font-size:12px;line-height:1.55}\n\n/* Actions */\n.primary{display:inline-flex;width:100%;min-height:48px;align-items:center;justify-content:center;padding:0 20px;border:0;border-radius:8px;background:var(--accent);color:var(--onaccent);font:600 14px/1 var(--body);cursor:pointer}\n.primary:hover{filter:brightness(1.06)}\n.primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}\n.primary:disabled{opacity:.55;cursor:default}\n.secondary{display:inline-flex;min-height:44px;align-items:center;margin-top:8px;color:var(--muted);font-size:12px;text-decoration:none}\n.secondary:hover{color:var(--ink);text-decoration:underline}\n.secondary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}\n\n/* Footer */\n.footer{margin-top:48px;padding-top:24px;border-top:1px solid var(--line)}\n\n@media(max-width:760px){\n  .page{padding:32px 24px}\n  .layout{grid-template-columns:1fr;gap:32px}\n  .summary{order:-1}\n  .document{padding:24px}\n  .doc-head{flex-direction:column;gap:16px}\n  .doc-meta{text-align:left}\n  .amount{font-size:56px}\n  .parties{grid-template-columns:1fr;gap:24px}\n  .facts div{grid-template-columns:96px minmax(0,1fr)}\n  .facts dd{text-align:left}\n  .brand-line{flex-direction:column;gap:8px}\n  .brand-line .label{white-space:normal}\n}\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n  <header class=\"brand-line\">\n    <div>\n      <p class=\"label\">Payments console</p>\n      <p class=\"brand\">North Studio</p>\n    </div>\n    <p class=\"label\">Invoice 0042 · Review only</p>\n  </header>\n\n  <main class=\"layout\">\n\n    <article class=\"document\" id=\"invoice-details\">\n      <header class=\"doc-head\">\n        <div>\n          <p class=\"label\">Supplier document</p>\n          <h1>Invoice 0042</h1>\n          <p class=\"muted\">Issued 6 November 2026</p>\n        </div>\n        <div class=\"doc-meta\">\n          <p class=\"label\">Due date</p>\n          <p>20 November 2026</p>\n        </div>\n      </header>\n\n      <div class=\"hero\">\n        <p class=\"label\">Amount to leave account</p>\n        <p class=\"amount\">€1,210.00</p>\n        <p class=\"muted\">Includes VAT €210.00 (21%)</p>\n      </div>\n\n      <div class=\"parties\">\n        <div>\n          <p class=\"label\">Supplier (payee)</p>\n          <p class=\"party-name\">North Studio</p>\n          <p class=\"muted\">14 Example Quay, Riverside Park,<br>Sample City, SC1 2AB</p>\n          <p class=\"muted\">accounts@northstudio.example</p>\n          <p class=\"muted\">VAT SAMPLE-GB-000042</p>\n        </div>\n        <div>\n          <p class=\"label\">Billed to (you)</p>\n          <p class=\"party-name\">Meridian Retail Group BV</p>\n          <p class=\"muted\">Boezemweg 14,<br>3051 SC Rotterdam, Netherlands</p>\n          <p class=\"muted\">VAT NL8641.22.905.B01</p>\n        </div>\n      </div>\n\n      <div class=\"table-wrap\">\n        <table class=\"items\">\n          <thead>\n            <tr><th scope=\"col\">Description</th><th scope=\"col\">Qty</th><th scope=\"col\">Unit price</th><th scope=\"col\">Amount</th></tr>\n          </thead>\n          <tbody>\n            <tr><td>Brand identity refresh, phase 2</td><td>1</td><td>€700.00</td><td>€700.00</td></tr>\n            <tr><td>Print-ready asset package</td><td>1</td><td>€300.00</td><td>€300.00</td></tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"totals\">\n        <div><span>Subtotal</span><span>€1,000.00</span></div>\n        <div><span>VAT (21%)</span><span>€210.00</span></div>\n        <div class=\"total\"><span>Total due</span><span>€1,210.00</span></div>\n      </div>\n    </article>\n\n    <aside class=\"summary\" aria-label=\"Payment review\">\n      <p class=\"label\">Payment review</p>\n      <p class=\"amount\">€1,210.00</p>\n      <dl class=\"facts\">\n        <div><dt>Supplier</dt><dd>North Studio</dd></div>\n        <div><dt>Due</dt><dd>20 November 2026</dd></div>\n        <div><dt>From</dt><dd>Business Current Account ending 4421</dd></div>\n        <div><dt>Destination</dt><dd>North Studio business account</dd></div>\n        <div><dt>Currency</dt><dd>EUR (€)</dd></div>\n      </dl>\n      <p class=\"consequence\">Review only. No payment is sent, scheduled or authorised from this screen.</p>\n      <button class=\"primary\" type=\"button\">Review payment</button>\n      <a class=\"secondary\" href=\"#invoice-details\">Back to invoice details</a>\n    </aside>\n\n  </main>\n\n  <footer class=\"footer\">\n    <p class=\"muted\">Read-only review of Invoice 0042 · Fictional demonstration data · No real payment</p>\n  </footer>\n\n</div>\n</body>\n</html>",
