      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; script-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'\">\n\n\n<title>Review payment · Invoice 0042 · North Studio</title>\n<style>\n  :root{\n    --canvas:#F4F0E8;\n    --surface:#FFFFFF;\n    --ink:#171614;\n    --muted:#6D6860;\n    --line:#E5DED2;\n    --accent:#1F5B46;\n    --onaccent:#FFFFFF;\n    --display:\"Iowan Old Style\",Palatino,\"Palatino Linotype\",Georgia,serif;\n    --body:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{\n    background:var(--canvas);\n    color:var(--ink);\n    font-family:var(--body);\n    font-size:14px;\n    line-height:1.5;\n    -webkit-font-smoothing:antialiased;\n  }\n  .page{max-width:1120px;margin:0 auto;padding:48px;box-sizing:border-box}\n  .layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:64px;align-items:start}\n\n  /* Header */\n  .brand-line{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:0 0 24px;border-bottom:1px solid var(--line);margin-bottom:48px}\n  .brand{margin:4px 0 0;font-family:var(--display);font-size:28px;line-height:1.1;letter-spacing:-.02em}\n  .brand-line .label{white-space:nowrap}\n\n  /* Typography helpers */\n  .label{margin:0;color:var(--muted);font-family:var(--body);font-size:11px;font-weight:500;letter-spacing:.08em;line-height:1.4;text-transform:uppercase}\n  .muted{margin:0;color:var(--muted);font-size:13px;line-height:1.5}\n  .amount{margin:8px 0 4px;font-family:var(--display);font-size:72px;font-weight:500;line-height:.95;letter-spacing:-.045em;font-variant-numeric:tabular-nums}\n\n  /* Document */\n  .document{background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 50px rgba(27,26,23,.06);padding:48px;min-width:0}\n  .doc-head{display:flex;justify-content:space-between;gap:32px;align-items:flex-start;padding-bottom:24px;border-bottom:1px solid var(--line)}\n  .doc-head h1{margin:4px 0 0;font-family:var(--display);font-size:40px;font-weight:500;letter-spacing:-.03em;line-height:1.05}\n  .doc-meta{text-align:right}\n  .doc-meta p{margin:4px 0 0;font-size:14px}\n  .parties{display:grid;grid-template-columns:1fr 1fr;gap:32px;padding:24px 0;border-bottom:1px solid var(--line)}\n  .parties h2{margin:8px 0 4px;font-family:var(--body);font-size:14px;font-weight:600}\n  .parties .addr{margin:8px 0 0;color:var(--muted);font-size:13px;line-height:1.5}\n  .parties .vat{display:inline-block;margin:12px 0 0;padding:4px 10px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:11px;letter-spacing:.04em}\n  .items{width:100%;border-collapse:collapse;margin:24px 0;font-size:14px;font-variant-numeric:tabular-nums}\n  .items th{padding:0 0 8px;border-bottom:1px solid var(--line);color:var(--muted);font-size:11px;font-weight:500;letter-spacing:.06em;text-align:left;text-transform:uppercase}\n  .items td{padding:14px 0;border-bottom:1px solid var(--line)}\n  .items th:first-child,.items td:first-child{width:52%}\n  .items th:not(:first-child),.items td:not(:first-child){text-align:right}\n  .totals{margin:8px 0 0;border-top:1px solid var(--line)}\n  .totals div{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--line);font-size:14px;font-variant-numeric:tabular-nums}\n  .totals div.grand{padding:16px 0 4px;font-size:16px;font-weight:600}\n  .doc-foot{margin:24px 0 0;padding-top:16px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}\n\n  /* Summary rail */\n  .summary{min-width:0}\n  .facts{margin:24px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n  .facts div{display:grid;grid-template-columns:120px minmax(0,1fr);gap:16px;padding:12px 0;border-bottom:1px solid var(--line)}\n  .facts div:last-child{border-bottom:0}\n  .facts dt{color:var(--muted);font-size:12px;line-height:1.5}\n  .facts dd{margin:0;text-align:right;font-size:14px;overflow-wrap:anywhere}\n  .consequence{margin:0 0 20px;color:var(--muted);font-size:12px;line-height:1.55}\n  .primary{display:inline-flex;width:100%;min-height:48px;align-items:center;justify-content:center;padding:0 20px;border:0;border-radius:8px;background:var(--accent);color:var(--onaccent);font:600 14px/1 var(--body);cursor:pointer}\n  .primary:hover{filter:brightness(1.06)}\n  .primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}\n  .secondary{display:inline-flex;min-height:44px;align-items:center;margin-top:8px;color:var(--muted);font-size:12px;text-decoration:underline;text-underline-offset:3px}\n  .secondary:hover{color:var(--ink)}\n\n  @media (max-width:760px){\n    .page{padding:32px 24px}\n    .layout{grid-template-columns:1fr;gap:32px}\n    .summary{order:-1}\n    .amount{font-size:56px}\n    .document{padding:24px}\n    .doc-head{flex-direction:column;gap:16px}\n    .doc-meta{text-align:left}\n    .parties{grid-template-columns:1fr;gap:24px}\n    .facts div{grid-template-columns:96px minmax(0,1fr)}\n    .facts dd{text-align:left}\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header class=\"brand-line\">\n    <div>\n      <p class=\"label\">Payments console</p>\n      <p class=\"brand\">North Studio</p>\n    </div>\n    <p class=\"label\">Invoice 0042 · Review only</p>\n  </header>\n  <main class=\"layout\">\n    <article class=\"document\" id=\"invoice-details\" aria-label=\"Invoice 0042\">\n      <header class=\"doc-head\">\n        <div>\n          <p class=\"label\">Supplier document</p>\n          <h1>Invoice 0042</h1>\n          <p class=\"muted\">Issued 6 November 2026</p>\n        </div>\n        <div class=\"doc-meta\">\n          <p class=\"label\">Due date</p>\n          <p>20 November 2026</p>\n        </div>\n      </header>\n      <div class=\"parties\">\n        <div>\n          <p class=\"label\">From (supplier)</p>\n          <h2>North Studio</h2>\n          <p class=\"addr\">14 Example Quay, Riverside Park,<br>Sample City, SC1 2AB</p>\n          <p class=\"muted\">accounts@northstudio.example</p>\n          <span class=\"vat\">VAT SAMPLE-GB-000042</span>\n        </div>\n        <div>\n          <p class=\"label\">Bill to (customer)</p>\n          <h2>Meridian Retail Group BV</h2>\n          <p class=\"addr\">Boezemweg 14,<br>3051 SC Rotterdam, Netherlands</p>\n          <span class=\"vat\">VAT NL8641.22.905.B01</span>\n        </div>\n      </div>\n      <table class=\"items\">\n        <thead>\n          <tr><th scope=\"col\">Description</th><th scope=\"col\">Qty</th><th scope=\"col\">Unit price</th><th scope=\"col\">Amount</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>Brand identity refresh, phase 2</td><td>1</td><td>€700.00</td><td>€700.00</td></tr>\n          <tr><td>Print-ready asset package</td><td>1</td><td>€300.00</td><td>€300.00</td></tr>\n        </tbody>\n      </table>\n      <div class=\"totals\">\n        <div><span>Subtotal</span><span>€1,000.00</span></div>\n        <div><span>VAT (21%)</span><span>€210.00</span></div>\n        <div class=\"grand\"><span>Total due</span><span>€1,210.00</span></div>\n      </div>\n      <p class=\"doc-foot\">Payment reference INV-0042 · Currency EUR · All amounts include VAT at 21%.</p>\n    </article>\n    <aside class=\"summary\" aria-label=\"Payment review\">\n      <p class=\"label\">Payment review</p>\n      <p class=\"amount\">€1,210.00</p>\n      <p class=\"muted\">Includes VAT €210.00 (21%)</p>\n      <dl class=\"facts\">\n        <div><dt>Supplier</dt><dd>North Studio</dd></div>\n        <div><dt>Due</dt><dd>20 November 2026</dd></div>\n        <div><dt>From</dt><dd>Business Current Account ending 4421</dd></div>\n        <div><dt>Destination</dt><dd>North Studio business account</dd></div>\n      </dl>\n      <p class=\"consequence\">Review only. No payment is sent, scheduled or authorised from this screen.</p>\n      <button class=\"primary\" type=\"button\">Review payment</button>\n      <a class=\"secondary\" href=\"#invoice-details\">Back to invoice details</a>\n    </aside>\n  </main>\n</div>\n</body>\n</html>",
