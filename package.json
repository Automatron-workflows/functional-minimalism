{
  "name": "@automatron/functional-minimalism",
  "version": "0.3.0",
  "description": "Functional minimalism for AI-built interfaces. Better first drafts, fewer retries, less token waste.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.16"
  },
  "bin": {
    "functional-minimalism": "./bin/functional-minimalism.mjs",
    "design-harness": "./bin/design-harness.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./browser": "./src/browser.mjs",
    "./node": "./src/node.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "package:source": "node scripts/package.mjs",
    "measure:context": "node scripts/measure-context.mjs"
  },
  "files": [
    "bin",
    "src",
    "packs",
    "adapters",
    "docs",
    "examples",
    "demo",
    "scripts",
    "README.md",
    "LICENSE",
    "DESIGN_RULES.md",
    "references",
    "Automatron_Design_Harness_Plan.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Automatron-workflows/functional-minimalism.git"
  },
  "homepage": "https://automatron-workflows.github.io/functional-minimalism/"
}
